# KaryaSetu Environment Variables Example

# Port (Render assigns PORT automatically in production; 5000 for local dev)
PORT=5000

# Environment mode (development / production)
NODE_ENV=production

# MongoDB Atlas URI (leave empty for zero-setup in-memory database mode)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/karyasetu?retryWrites=true&w=majority
MONGODB_URI=

# Database Reset Flag (set to 'true' only if you want to wipe MongoDB on server start)
RESET_DB_ON_START=false

# Razorpay API Credentials (optional: test sandbox credentials used by default)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
